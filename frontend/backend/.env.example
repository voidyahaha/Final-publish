FIREBASE_STORAGE_BUCKET=vocal-separater-5eb7c.firebasestorage.app
# Mount a service-account JSON secret on the host; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
CORS_ORIGINS=https://your-site.vercel.app,http://localhost:8000
DEMUCS_MODEL=htdemucs_ft
DEMUCS_DEVICE=auto
JOB_WORKERS=1
MAX_UPLOAD_MB=250
AUDIO_DATA_DIR=/var/lib/sonder/audio
PORT=8000
