FIREBASE_STORAGE_BUCKET=vocal-separater-5eb7c.firebasestorage.app
# Mount a service-account JSON secret on the host; never commit it.
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
# For Render or another container platform, set the complete service account
# JSON as a secret instead of writing it to the image filesystem.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
CORS_ORIGINS=https://your-site.vercel.app,http://localhost:5173
DEMUCS_MODEL=htdemucs_ft
DEMUCS_DEVICE=auto
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_MB=250
AUDIO_DATA_DIR=/var/lib/sonder/audio
PORT=8000
